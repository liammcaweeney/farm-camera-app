# Public entry point — Caddy terminates TLS here now (Let's Encrypt).
# Previously the Oracle VPS did TLS and forwarded over the reverse SSH tunnel;
# the VPS is gone, so traffic arrives straight from the internet via router
# port-forward 80/443 -> this Pi.
killywilly.duckdns.org {
    handle /api/wedding-rsvp {
        uri replace /api/wedding-rsvp /rsvp
        reverse_proxy host.docker.internal:3000
    }

    reverse_proxy oauth2-proxy:4180
}

# Wedding subdomain — moved off the VPS Caddyfile, same 301 as before
wedding.killywilly.duckdns.org {
    redir https://www.liamandaineswedding.com{uri} 301
}

# Internal backend — only reachable via oauth2-proxy
:8081 {
    redir / /cameras/ 302

    @portainer_exact path /portainer
    redir @portainer_exact /portainer/ 301

    handle_path /portainer/* {
        reverse_proxy portainer:9000
    }

    @monitoring_exact path /monitoring
    redir @monitoring_exact /monitoring/ 301

    handle_path /monitoring/* {
        reverse_proxy glances:61208
    }

    @nvr_exact path /nvr
    redir @nvr_exact /nvr/ 301

    handle_path /nvr/* {
        reverse_proxy 192.168.1.101:80 {
            header_up Authorization "Basic YWRtaW46YWRtaW4="
            header_up Host "192.168.1.101"
            transport http {
                versions 1.1
            }
        }
    }

    @cameras path /cameras
    redir @cameras /cameras/ 301

    handle_path /cameras/* {
        root * /srv/cameras
        file_server
    }

    @tapo path /tapo /tapo/
    redir @tapo /cameras/tapo.html 302

    handle /tapo-ptz4* {
        uri replace /tapo-ptz4 /tapo-ptz
        reverse_proxy tapo-ptz4:3001
    }

    handle /tapo-ptz3* {
        uri replace /tapo-ptz3 /tapo-ptz
        reverse_proxy tapo-ptz3:3001
    }

    handle /tapo-ptz2* {
        uri replace /tapo-ptz2 /tapo-ptz
        reverse_proxy tapo-ptz2:3001
    }

    handle /tapo-ptz* {
        reverse_proxy tapo-ptz:3001
    }

    handle_path /whep/* {
        reverse_proxy mediamtx:8889
    }

    handle_path /hls/* {
        reverse_proxy mediamtx:8888
    }

}
