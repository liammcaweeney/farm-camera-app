# Google OAuth (https://console.cloud.google.com)
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
COOKIE_SECRET=                    # generate: openssl rand -hex 16

# Public URL
PUBLIC_URL=https://your-domain.duckdns.org
COOKIE_DOMAIN=your-domain.duckdns.org

# TURN server (coturn with use-auth-secret)
TURN_USERNAME=                    # format: timestamp:name e.g. 1800000000:user
TURN_PASSWORD=                    # HMAC-SHA1 of username using static-auth-secret

# Tapo camera (URL-encode special chars e.g. ! → %21)
TAPO_IP=
TAPO_USER=
TAPO_PASS=

# Cam4 "the back" (URL-encode special chars e.g. ! → %21) — IP moves around, keep it current
CAM4_IP=
CAM4_USER=
CAM4_PASS=

# Cam5 "dry cows" (URL-encode special chars e.g. ! → %21)
CAM5_USER=
CAM5_PASS=

# Rosie / hay shed camera (URL-encode special chars e.g. ! → %21)
ROSIE_USER=
ROSIE_PASS=

# DuckDNS
DUCKDNS_TOKEN=
